---
import type { Boliche } from '../lib/types';
import { estaActivo } from '../lib/types';

interface Props {
  boliches: Boliche[];
}

const { boliches } = Astro.props;

const porDecada = new Map<number, { activos: number; cerrados: number }>();
for (const b of boliches) {
  if (b.anioInicio == null) continue;
  const decada = Math.floor(b.anioInicio / 10) * 10;
  const entry = porDecada.get(decada) ?? { activos: 0, cerrados: 0 };
  if (estaActivo(b)) entry.activos += 1;
  else entry.cerrados += 1;
  porDecada.set(decada, entry);
}

const decadas = [...porDecada.entries()]
  .map(([decada, counts]) => ({ decada, ...counts, total: counts.activos + counts.cerrados }))
  .sort((a, b) => a.decada - b.decada);

const maxTotal = Math.max(...decadas.map((d) => d.total), 1);

const decadaPico = decadas.reduce((max, d) => (d.total > max.total ? d : max), decadas[0]);
const hallazgo =
  decadaPico && decadaPico.cerrados > 0
    ? `De los ${decadaPico.total} lugares que abrieron en los ${decadaPico.decada}, hoy siguen activos ${decadaPico.activos}.`
    : null;
---

{
  decadas.length > 0 && (
    <div class="mt-6 rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-sm font-semibold text-slate-600 dark:text-slate-300">La noche, década a década</h2>
      {hallazgo && <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{hallazgo}</p>}

      <div class="mt-4 flex flex-col gap-2">
        {decadas.map((d) => (
          <div class="flex items-center gap-3">
            <span class="w-12 shrink-0 text-sm text-slate-500 dark:text-slate-400">{d.decada}s</span>
            <div class="flex h-5 flex-1 overflow-hidden rounded bg-slate-100 dark:bg-slate-800">
              <div
                class="h-full bg-emerald-500"
                style={`width: ${(d.activos / maxTotal) * 100}%`}
                title={`${d.activos} activos`}
              />
              <div
                class="h-full bg-slate-400 dark:bg-slate-600"
                style={`width: ${(d.cerrados / maxTotal) * 100}%`}
                title={`${d.cerrados} cerrados`}
              />
            </div>
            <span class="w-6 shrink-0 text-right text-sm tabular-nums text-slate-600 dark:text-slate-300">
              {d.total}
            </span>
          </div>
        ))}
      </div>

      <div class="mt-3 flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
        <span class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-sm bg-emerald-500" /> Activos hoy
        </span>
        <span class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-sm bg-slate-400 dark:bg-slate-600" /> Cerrados
        </span>
      </div>
    </div>
  )
}
