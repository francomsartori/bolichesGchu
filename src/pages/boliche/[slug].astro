---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import VenueMap from '../../components/VenueMap.tsx';
import { getBoliches } from '../../lib/getBoliches';
import { rangoAnios, estaActivo } from '../../lib/types';
import { TIPO_LABELS, TIPO_COLORS, TIPO_PIN_COLORS, contrastText } from '../../lib/tipoStyles';

export async function getStaticPaths() {
  const boliches = await getBoliches();
  return boliches.map((boliche) => ({
    params: { slug: boliche.slug },
    props: { boliche },
  }));
}

const { boliche } = Astro.props;
const activo = estaActivo(boliche);
const tipoColor = TIPO_PIN_COLORS[boliche.tipo] ?? TIPO_COLORS[boliche.tipo];
---

<Layout title={`${boliche.nombre} — Boliches Gualeguaychú`} description={boliche.descripcion}>
  <a href="/" class="mb-4 inline-block text-sm text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200">
    ← Volver al listado
  </a>

  <div class="flex flex-wrap items-start justify-between gap-2">
    <h1 class="text-3xl font-bold">{boliche.nombre}</h1>
    <span
      class="rounded-full px-3 py-1 text-sm font-medium"
      style={`background-color: ${tipoColor}; color: ${contrastText(tipoColor)}`}
    >
      {TIPO_LABELS[boliche.tipo]}
    </span>
  </div>

  <div class="mt-2 flex flex-wrap items-center gap-3 text-slate-600 dark:text-slate-300">
    <span class="text-lg font-medium">
      {rangoAnios(boliche)}
      {boliche.verificado && (
        <span class="ml-1 text-emerald-600 dark:text-emerald-400" title="Dato verificado">✓</span>
      )}
    </span>
    <span class={`text-sm font-medium ${activo ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'}`}>
      {activo ? 'Activo' : 'Cerrado'}
    </span>
  </div>

  {boliche.direccion && <p class="mt-1 text-slate-500 dark:text-slate-400">{boliche.direccion}</p>}

  {
    boliche.verificado && (
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-500">Datos verificados en persona</p>
    )
  }

  <div class="mt-6">
    <VenueMap client:only="react" boliche={boliche} />
  </div>

  {boliche.descripcion && <p class="mt-6 leading-relaxed text-slate-600 dark:text-slate-300">{boliche.descripcion}</p>}

  <div class="mt-6 rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-sm font-semibold text-slate-600 dark:text-slate-300">Detalle</h2>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{boliche.detalle ?? 'Sin datos'}</p>
  </div>

  <div class="mt-6 rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-sm font-semibold text-slate-600 dark:text-slate-300">Fotos</h2>
    {
      boliche.imagenes && boliche.imagenes.length > 0 ? (
        <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-3">
          {boliche.imagenes.map((src) => (
            <img src={src} alt={boliche.nombre} class="rounded-lg border border-slate-200 object-cover dark:border-slate-800" />
          ))}
        </div>
      ) : (
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Sin datos</p>
      )
    }
  </div>

  <div class="mt-6 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-900/50 dark:bg-amber-950/20 dark:text-amber-200">
    ¿Tenés información para agregar o actualizar sobre este boliche?{' '}
    <a href={`/reportar?boliche=${encodeURIComponent(boliche.nombre)}`} class="underline hover:text-amber-950 dark:hover:text-amber-100">
      Contanos acá
    </a>.
  </div>
</Layout>
