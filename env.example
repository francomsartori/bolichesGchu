# Sanity project connection for the Astro frontend.
# Copy this file to ".env" and fill in the values after creating a real Sanity
# project (see README.md). Leave them unset to keep running on local seed data.
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production

# Write token (Sanity manage -> API -> Tokens). Server-side only, never PUBLIC_.
# Used only by one-off scripts (e.g. scripts/seed-to-sanity.mjs), never shipped to the browser.
SANITY_WRITE_TOKEN=

# Resend API key (resend.com -> API Keys), used by src/pages/api/contacto.ts
# to email corrections/new venue reports. For local `astro dev` this actually
# needs to go in a ".dev.vars" file (Cloudflare's local-secrets convention),
# not here — see .dev.vars.example. In production it's set as a Cloudflare
# Workers secret (`wrangler secret put RESEND_API_KEY`), never committed.
RESEND_API_KEY=